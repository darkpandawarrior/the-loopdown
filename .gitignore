# --- SECRETS (never pushed) ---
.env
.env.local

# --- PRIVATE LAYER (never pushed) ---
# Personal/admin docs, original binaries, and any performance data with
# account-identifying detail. Mirrors the DATA_CONTRACT public/private split.
private/

# node
scripts/node_modules/
node_modules/
npm-debug.log*

# os / editor
.DS_Store
*.swp
.idea/
.vscode/

# derived paste-ready exports
lessons/**/out/

# scratch
*.tmp
.tmp_*

# per-lesson publish state (dev.to article ids etc; adopted via API)
lessons/**/state.json

# generated report
dashboard.html

# derived: regenerated by scripts/carousel.mjs in seconds, and referenced
# nowhere remotely (only the slide PNGs and card.png need raw URLs)
lessons/**/assets/carousel.pdf

# scheduler state / logs
data/publish.log
data/launchd-*.log
data/linkedin-queue.md

# Code knowledge graph (graphify). Derived, rebuildable, and large; it also mirrors every
# symbol name in the repo, so it is never committed. Rebuild: node ~/Tools/DevTools/AgentHarness/scripts/graph.mjs build
graphify-out/

# The Morkinstar Journals: derived artifacts, all regenerable and large.
# Full-res plates are ~45MB (node scripts/morkinstar-plates.mjs).
# The standalone reader is ~2.2MB and rebuilt on every change
# (node scripts/morkinstar-site.mjs). The half-scale web JPEGs in
# assets/web/ ARE committed: the cv-siddharth build fetches them.
fiction/morkinstar-journals/assets/*.png
fiction/morkinstar-journals/site.html
